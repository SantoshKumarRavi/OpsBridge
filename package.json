{
  "name": "opsbridge-workspace",
  "private": true,
  "workspaces": [
    "apps/operations-dashboard",
    "apps/integration-console",
    "apps/worker-portal",
    "apps/compliance-console",
    "apps/frontend-patterns",
    "apps/careers-site",
    "packages/auth-client",
    "packages/api-client"
  ],
  "scripts": {
    "dev:ops": "npm --workspace apps/operations-dashboard run dev",
    "dev:integrations": "npm --workspace apps/integration-console run dev",
    "dev:portal": "npm --workspace apps/worker-portal run dev",
    "dev:compliance": "npm --workspace apps/compliance-console run start",
    "dev:mobile": "npm --workspace apps/field-app run start",
    "dev:ui-patterns": "npm --workspace apps/frontend-patterns run dev",
    "build:spring-cloud-discovery": "mvn -f services/spring-cloud-discovery-lab/pom.xml package",
    "analyze:worker": "npm --workspace apps/worker-portal run analyze",
    "analyze:careers": "npm --workspace apps/careers-site run analyze",
    "analyze:frontends": "npm run analyze:worker && npm run analyze:careers",
    "test:ai-runtime": "python -m unittest discover -s services/ai-runtime/tests -v",
    "test:api-client": "node --experimental-strip-types --test packages/api-client/test/*.test.ts",
    "generate:api-client-types": "npm --workspace packages/api-client run generate:types",
    "build:api-client": "npm --workspace packages/api-client run build",
    "test:dsa": "python -m unittest practice.dsa.test_solutions -v",
    "test:compliance-api": "python services/compliance-api/manage.py test onboarding.tests --settings=config.test_settings --verbosity=2",
    "test:compliance-api:coverage": "python -m coverage erase && python -m coverage run --rcfile=services/compliance-api/.coveragerc services/compliance-api/manage.py test onboarding.tests --settings=config.test_settings --verbosity=2 && python -m coverage report --rcfile=services/compliance-api/.coveragerc && python -m coverage html --rcfile=services/compliance-api/.coveragerc --directory=services/compliance-api/htmlcov",
    "test:gateway-contract": "python scripts/verify_gateway_compliance_contract.py",
    "test:load:locust": "python scripts/verify_gateway_compliance_contract.py --locust",
    "test:load:k6": "python scripts/verify_gateway_compliance_contract.py --k6",
    "test:load:jmeter": "python scripts/verify_gateway_compliance_contract.py --jmeter",
    "test:worker-contract-e2e": "python scripts/verify_gateway_compliance_contract.py --browser",
    "test:worker-contract-e2e:browsers": "python scripts/verify_gateway_compliance_contract.py --browser-projects=all",
    "test:cqrs": "python -m unittest discover -s services/cqrs-lab -v",
    "test:correlation": "python -m unittest discover -s services/compliance-api/tests -v",
    "test:event-consumer": "python -m unittest discover -s services/event-consumer -p test_*.py -v",
    "verify:keycloak-realm": "python scripts/verify_keycloak_realm.py",
    "test:saga": "python -m unittest discover -s services/saga-lab -v",
    "test:e2e": "playwright test",
    "test:compliance-console": "playwright test --config=playwright.compliance.config.ts",
    "test:e2e:typecheck": "tsc --noEmit --moduleResolution bundler --module ESNext --target ES2020 --esModuleInterop --skipLibCheck --types node tests/e2e/accessibility.spec.ts tests/e2e/worker-case-contract.spec.ts tests/e2e/worker-keyboard-navigation.spec.ts tests/e2e/worker-onboarding.spec.ts",
    "build:frontends": "npm run build --workspace apps/worker-portal && npm run build --workspace apps/careers-site && npm run build --workspace apps/operations-dashboard && npm run build --workspace apps/compliance-console && npm run build --workspace apps/integration-console && npm run build --workspace apps/frontend-patterns"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "latest",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
