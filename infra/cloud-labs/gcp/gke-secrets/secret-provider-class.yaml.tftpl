apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: opsbridge-runtime-secret
  namespace: ${NAMESPACE}
spec:
  provider: gke
  parameters:
    secrets: |
      - resourceName: "projects/${PROJECT_ID}/secrets/${SECRET_ID}/versions/latest"
        path: "runtime-secret"
